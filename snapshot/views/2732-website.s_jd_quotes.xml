<t name="Judge Quotes" t-name="website.s_jd_quotes">
    <t t-set="uniq" t-value="datetime.datetime.now().microsecond"/>
    <section class="s_jd_quotes_wrapper " data-snippet="s_jd_quotes" data-name="Judge Quotes"><div class="s_jd_quotes_inner"><div class="s_jd_quotes_label"><span>In their words</span><span class="s_jd_rule_fill"/></div><div t-attf-id="jdQuotes{{uniq}}" class="s_jd_quotes carousel carousel-fade slide" data-bs-ride="true" data-bs-interval="7000" data-bs-pause="hover"><div class="carousel-inner"><div class="carousel-item active" data-name="Slide"><blockquote class="s_blockquote s_jd_quote_block" data-snippet="s_blockquote" data-name="Blockquote"><p class="s_jd_quote_text">Write a quote here from someone you wrote for — the line they still repeat back to you months later.</p><footer class="s_jd_quote_cite"><strong>Their name</strong> — The occasion</footer></blockquote></div><div class="carousel-item" data-name="Slide"><blockquote class="s_blockquote s_jd_quote_block" data-snippet="s_blockquote" data-name="Blockquote"><p class="s_jd_quote_text">Or drop in an excerpt from a tribute you wrote, and let the writing make the case on its own.</p><footer class="s_jd_quote_cite"><strong>From a eulogy</strong> — Place, year</footer></blockquote></div><div class="carousel-item" data-name="Slide"><blockquote class="s_blockquote s_jd_quote_block" data-snippet="s_blockquote" data-name="Blockquote"><p class="s_jd_quote_text">Keep each one short. Two lines lands harder than ten, and the carousel gives every quote its own moment.</p><footer class="s_jd_quote_cite"><strong>Their name</strong> — The occasion</footer></blockquote></div></div><div class="s_jd_quotes_controls o_not_editable" contenteditable="false"><div class="carousel-indicators s_jd_quotes_dots"><button type="button" t-attf-data-bs-target="#jdQuotes{{uniq}}" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Quote 1"/><button type="button" t-attf-data-bs-target="#jdQuotes{{uniq}}" data-bs-slide-to="1" aria-label="Quote 2"/><button type="button" t-attf-data-bs-target="#jdQuotes{{uniq}}" data-bs-slide-to="2" aria-label="Quote 3"/></div><div class="s_jd_quotes_arrows"><button class="carousel-control-prev" type="button" t-attf-data-bs-target="#jdQuotes{{uniq}}" data-bs-slide="prev" aria-label="Previous quote"><span aria-hidden="true">←</span></button><button class="carousel-control-next" type="button" t-attf-data-bs-target="#jdQuotes{{uniq}}" data-bs-slide="next" aria-label="Next quote"><span aria-hidden="true">→</span></button></div></div></div></div></section>
</t>
